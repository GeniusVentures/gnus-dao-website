# GNUS-DAO-Website Environment Configuration
# This file contains NON-SECRET configuration only.
# All secrets (API keys, private keys, tokens) are managed through HashiCorp Vault.
#
# To set up Vault and migrate secrets:
# 1. Install Vault CLI: https://www.vaultproject.io/downloads
# 2. Start Vault: docker-compose up vault-dev
# 3. Initialize Vault: ./scripts/vault-init.sh
# 4. Authenticate: vault login -method=github token=$(gh auth token)
# 5. Migrate secrets: ./scripts/setup/migrate-secrets-to-vault.sh
#
# For detailed setup instructions, see: docs/devs/VAULT_SETUP.md
# For troubleshooting, see: docs/devs/VAULT_TROUBLESHOOTING.md

# ============================================================================
# VAULT CONFIGURATION (Required)
# ============================================================================
# Vault server address - set this to match your docker-compose.yml
VAULT_ADDR=http://vault-dev:8200

# GitHub Personal Access Token for Vault authentication
# Create at: https://github.com/settings/tokens (needs 'repo' scope)
GITHUB_TOKEN=your_github_token_here

# ============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================

# OpenZeppelin Defender Configuration (Non-secret settings)
DEFENDER_DEPLOY_ON=false
DEFENDER_AUTO_APPROVE=false
DEFENDER_VIA_TYPE=EOA
DEFENDER_GAS_LIMIT=5000000
DEFENDER_MAX_GAS_PRICE=50000000000

# JB IDE Configuration
JB_IDE_HOST=on

# ============================================================================
# HARDHAT NETWORK CONFIGURATION
# ============================================================================

# Default Hardhat chain ID for local development
HH_CHAIN_ID=31337

# Single Hardhat chain fork (uncomment and set if needed)
# FORK_URL=
# FORK_BLOCK_NUMBER=

# ============================================================================
# FORK CONFIGURATION: Pinned Block Numbers
# ============================================================================
# These are used for reproducible testing with forked networks
# Chain IDs are mocked and not required for these configurations

# MAINNET_MOCK_CHAIN_ID=
# MAINNET_BLOCK_NUMBER=
# SEPOLIA_MOCK_CHAIN_ID=
# SEPOLIA_BLOCK_NUMBER=

# POLYGON_MOCK_CHAIN_ID=
# POLYGON_BLOCK_NUMBER=
# POLYGON_AMOY_MOCK_CHAIN_ID=
# POLYGON_AMOY_BLOCK_NUMBER=

# BASE_MOCK_CHAIN_ID=
# BASE_BLOCK_NUMBER=

# BSC_MOCK_CHAIN_ID=
# BSC_BLOCK_NUMBER=

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Diamond contract configuration
DIAMOND_NAME=GNUSDAODiamond
DIAMOND_CONFIG_PATH=diamonds/GNUSDAODiamond/gnusdaodiamond.config.json

# Deployment paths
DEPLOYMENTS_PATH=diamonds
CONTRACTS_PATH=contracts

# RPC Deployment settings (non-secret)
GAS_LIMIT_MULTIPLIER=1.2
MAX_RETRIES=3
RETRY_DELAY_MS=2000
VERBOSE=true
WRITE_DEPLOYED_DIAMOND_DATA=true

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================
# Network settings for deployment (RPC URLs are stored in Vault)
# Update these to match your target deployment network

NETWORK_NAME=sepolia
CHAIN_ID=11155111
BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# ============================================================================
# IMPORTANT NOTES
# ============================================================================
#
# 1. NEVER commit actual secret values to this file
# 2. All secrets are stored in Vault at paths like:
#    - secret/dev/PRIVATE_KEY
#    - secret/dev/INFURA_API_KEY
#    - secret/dev/ETHERSCAN_API_KEY
# 3. Use the vault-fetch-secrets.sh script to load secrets at runtime
# 4. The priority order is: Vault > .env > defaults
# 5. For local development, secrets are loaded automatically on container start
#
# ============================================================================