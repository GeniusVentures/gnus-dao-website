SOCKET_CLI_API_TOKEN=

ETHERSCAN_API_KEY=

TEST_PRIVATE_KEY=
# USED AS THE DEFAULT FOR MULTICHAIN FORKS
HH_CHAIN_ID=31337

DIAMOND_NAME=GNUSDAODiamond

DIAMOND_CONFIG_PATH=diamonds/GNUSDAODiamond/gnusdaodiamond.config.json

# Deployment paths
DEPLOYMENTS_PATH=diamonds
CONTRACTS_PATH=contracts



# ===== SECURITY NOTICE =====
# 🔒 This is a template file. Copy to .env.local and fill with real values
# 🚨 NEVER commit .env.local or any file with real API keys to version control
# 📋 For production deployment, set these in your hosting platform's environment variables

# ===== REQUIRED VARIABLES =====

# WalletConnect Project ID (REQUIRED)
# Get your project ID from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Contract Addresses for Different Chains
NEXT_PUBLIC_ETHEREUM_GNUS_DAO_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SEPOLIA_GNUS_DAO_ADDRESS=0x84Ba28d277ded98b3488C906E90B6435B116D5b4
NEXT_PUBLIC_BASE_GNUS_DAO_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_POLYGON_GNUS_DAO_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SKALE_GNUS_DAO_ADDRESS=0x0000000000000000000000000000000000000000

# ===== OPTIONAL VARIABLES =====

# RPC URLs (will use public endpoints if not provided)
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth.llamarpc.com
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon.llamarpc.com
NEXT_PUBLIC_SKALE_RPC_URL=https://mainnet.skalenodes.com/v1/your-chain-name
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_api_key

# API Keys (optional - for enhanced performance)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
NEXT_PUBLIC_INFURA_API_KEY=your_infura_api_key_here

# Application Configuration
NEXT_PUBLIC_APP_NAME="GNUS DAO"
NEXT_PUBLIC_APP_URL=https://dao.gnus.ai
NEXT_PUBLIC_APP_VERSION=1.0.0

# ===== SENSITIVE VARIABLES (Handle with care) =====

# IPFS Configuration for Proposal Metadata and File Storage
# 🔒 SECURITY: These are sensitive credentials - never commit real values
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY_BACKUP=https://gateway.pinata.cloud/ipfs/
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
NEXT_PUBLIC_PINATA_SECRET_KEY=your_pinata_secret_key_here
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_token_here

# IPFS Node Configuration (optional - for direct IPFS node connection)
NEXT_PUBLIC_IPFS_API_URL=https://ipfs.infura.io:5001
NEXT_PUBLIC_IPFS_API_KEY=your_infura_ipfs_project_id_here
NEXT_PUBLIC_IPFS_API_SECRET=your_infura_ipfs_project_secret_here

# IPFS Settings
NEXT_PUBLIC_IPFS_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_IPFS_ALLOWED_TYPES=image/*,application/pdf,text/plain,application/json
NEXT_PUBLIC_IPFS_PIN_TO_CLUSTER=true

# ===== DEVELOPMENT CONFIGURATION =====
NODE_ENV=development
NEXT_PUBLIC_ENABLE_TESTNETS=true
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_TELEMETRY_DISABLED=1

# Bundle Analysis (set to 'true' to analyze bundle size)
ANALYZE=false

# ===== SECURITY GUIDELINES =====
# 🔒 NEVER commit .env.local to version control
# 🌐 All NEXT_PUBLIC_ variables are exposed to the browser
# 🔑 WalletConnect Project ID is required for wallet connections
# 🌍 RPC URLs are optional - the app will use public endpoints as fallbacks
# ☁️  For production deployment, set these in your hosting platform's environment variables
# 🚨 Remove hardcoded API keys from source code and use environment variables instead
# 📋 Use different credentials for development, staging, and production environments

# ===== ERROR TRACKING & MONITORING =====
# Sentry Configuration for Error Tracking
# Get your DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_sentry_org_here
SENTRY_PROJECT=your_sentry_project_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Environment for error tracking
NEXT_PUBLIC_ENVIRONMENT=development
ENVIRONMENT=development

# Enable Sentry in development (optional)
NEXT_PUBLIC_SENTRY_DEBUG=false
SENTRY_DEBUG=false

# ===== CRITICAL ERROR ALERTING =====
# Enable critical error alerting (automatically enabled in production)
ENABLE_CRITICAL_ALERTS=false

# Webhook URLs for critical alerts
CRITICAL_ALERT_WEBHOOK_URL=your_webhook_url_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Email recipients for critical alerts (comma-separated)
CRITICAL_ALERT_EMAILS=security@gnus.ai,devops@gnus.ai

# Enable test alerts endpoint (development only)
ENABLE_TEST_ALERTS=true

# ===== CLOUDFLARE PAGES DEPLOYMENT =====
# Set these environment variables in your Cloudflare Pages dashboard:
# - NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
# - NEXT_PUBLIC_SEPOLIA_GNUS_DAO_ADDRESS
# - NEXT_PUBLIC_PINATA_API_KEY
# - NEXT_PUBLIC_PINATA_SECRET_KEY
# - NEXT_PUBLIC_PINATA_JWT
# - NEXT_PUBLIC_SENTRY_DSN
# - SENTRY_DSN
# - SENTRY_ORG
# - SENTRY_PROJECT
# - SENTRY_AUTH_TOKEN
# - NEXT_PUBLIC_ENVIRONMENT (set to 'production')
# - Any custom RPC URLs or API keys you want to use
