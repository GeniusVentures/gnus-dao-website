{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Main worker entry point (generated by OpenNext)
  "main": ".open-next/worker.js",
  
  // Project name
  "name": "gnus-dao-web",
  
  // Compatibility settings
  // Must be 2024-09-23 or later for @opennextjs/cloudflare
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API compatibility
    // https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  
  // Static assets configuration (generated by OpenNext)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  
  // Self-reference service binding for internal routing
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "gnus-dao-web"
    }
  ],
  
  // KV namespaces for data storage
  "kv_namespaces": [
    {
      "binding": "AUTH_SESSIONS",
      "id": "669cfebda6a544e0a2a66b482a5b5e35",
      "preview_id": "c03ccc431a3540be9dbbf3eade06dcc5"
    },
    {
      "binding": "IPFS_CACHE",
      "id": "22f5c52a20ba44d3b060975e212f1e42",
      "preview_id": "0779abda6db947c982834b4474a619df"
    },
    {
      "binding": "APP_CACHE",
      "id": "8e2dd1e6309844cbbce9a9ffa901d37e",
      "preview_id": "6dfc2abf75cd4de99807c282c462bc8d"
    }
  ],
  
  // R2 buckets for Next.js incremental cache (optional)
  // Uncomment and configure to enable ISR caching with R2
  // Also uncomment incrementalCache in open-next.config.ts
  "r2_buckets": [
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "gnus-dao-cache"
    // }
  ],
  
  // Global environment variables
  "vars": {
    "CLOUDFLARE_PAGES": "true",
    "NODE_ENV": "production"
  }
  
  // Note: Sensitive environment variables should be set via:
  // - Cloudflare Dashboard: Workers & Pages > Your Worker > Settings > Variables
  // - Wrangler CLI: wrangler secret put <KEY>
  // 
  // Required environment variables:
  // - NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
  // - NEXT_PUBLIC_ALCHEMY_API_KEY (optional)
  // - NEXT_PUBLIC_INFURA_API_KEY (optional)
  // - PINATA_JWT (server-side only)
  // 
  // See .env.example for full list
}

