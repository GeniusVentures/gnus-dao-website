    "ethers": "^6.13.2",
    "framer-motion": "^11.11.7",
    "helia": "^6.0.8",
    "isomorphic-dompurify": "^2.33.0",
    "lucide-react": "^0.451.0",
    "multiformats": "^13.4.1",
    "next": "^14.2.35",
    "next-themes": "^0.4.6",
    "pinata": "^2.5.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.0",
    "react-redux": "^9.2.0",
    "recharts": "^3.3.0",
    "siwe": "^2.3.2",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.39.3",
    "zod": "^3.23.8"
  },
