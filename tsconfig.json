{
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs",
      "esModuleInterop": true
    }
  },
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "ES6"
    ],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDirs": [
      "./scripts",
      "./test",
      "./test-suites",
      "./typechain-types"
    ],
    "outDir": "dist",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "typeRoots": [
      "node_modules/@types",
      "./types"
    ],
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "node",
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/store/*": [
        "./src/store/*"
      ],
      "@/types/*": [
        "./src/types/*"
      ],
      "@/utils/*": [
        "./src/lib/utils/*"
      ],
      "@/typechain-types/*": [
        "./typechain-types/*"
      ]
    },
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "./scripts",
    "./test",
    "./test-suites",
    "./typechain-types",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "out/types/**/*.ts",
    "typechain-types/**/*.ts"
  ],
  "files": [
    "./hardhat.config.ts"
  ],
  "exclude": [
    "./notes/**/*",
    "./node_modules",
    "./dist",
    "./artifacts",
    "./coverage",
    "./cache",
    "./types",
    "./typechain-types/**/*",
    "./diamond-typechain-types/**/*",
    "node_modules",
    ".next",
    "out",
    "dist"
  ],
}