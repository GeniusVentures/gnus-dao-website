{
  "$schema": "node_modules/wrangler/config-schema.json",
  
  // Project name
  "name": "gnus-dao-web",
  
  // Pages build output directory for static deployment
  "pages_build_output_dir": "out",
  
  // Compatibility settings
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API compatibility for Cloudflare Functions
    "nodejs_compat"
  ],
  
  // KV namespaces for data storage
  "kv_namespaces": [
    {
      "binding": "AUTH_SESSIONS",
      "id": "669cfebda6a544e0a2a66b482a5b5e35",
      "preview_id": "c03ccc431a3540be9dbbf3eade06dcc5"
    },
    {
      "binding": "IPFS_CACHE",
      "id": "22f5c52a20ba44d3b060975e212f1e42",
      "preview_id": "0779abda6db947c982834b4474a619df"
    },
    {
      "binding": "APP_CACHE",
      "id": "8e2dd1e6309844cbbce9a9ffa901d37e",
      "preview_id": "6dfc2abf75cd4de99807c282c462bc8d"
    }
  ],
  
  // R2 buckets for Next.js incremental cache (optional)
  // Uncomment and configure to enable ISR caching with R2
  // Also uncomment incrementalCache in open-next.config.ts
  "r2_buckets": [
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "gnus-dao-cache"
    // }
  ],
  
  // Global environment variables
  "vars": {
    "CLOUDFLARE_PAGES": "true",
    "NODE_ENV": "production"
  },
  
  // Note: Sensitive environment variables should be set via:
  // - Cloudflare Dashboard: Workers & Pages > Your Worker > Settings > Variables
  // - Wrangler CLI: wrangler secret put <KEY>
  // 
  // Required environment variables for production:
  // - NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID (required)
  // - NEXT_PUBLIC_SEPOLIA_GNUS_DAO_ADDRESS (required)
  // - NEXT_PUBLIC_PINATA_JWT (optional, for IPFS uploads)
  // - SENTRY_DSN (optional, for error tracking)
  // 
  // See .env.example for full list
  
  // To switch to OpenNext adapter (for SSR support):
  // 1. Uncomment the sections below
  // 2. Change pages_build_output_dir to ".open-next/assets"
  // 3. Run: yarn build:cloudflare instead of yarn build:pages
  
  // OpenNext configuration (currently disabled):
  // "main": ".open-next/worker.js",
  // "assets": {
  //   "directory": ".open-next/assets",
  //   "binding": "ASSETS"
  // },
  // "services": [
  //   {
  //     "binding": "WORKER_SELF_REFERENCE",
  //     "service": "gnus-dao-web"
  //   }
  // ]
}

